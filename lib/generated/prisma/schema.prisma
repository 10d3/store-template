generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  coverImage     String?
  content        String?    @db.Text
  seoTitle       String?
  seoDescription String?
  authorId       String
  published      Boolean    @default(false)
  views          Int        @default(0)
  author         User       @relation(fields: [authorId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  BlogView       BlogView[]
}

model BlogView {
  id               String   @id @default(cuid())
  blogId           String
  blog             Blog     @relation(fields: [blogId], references: [id])
  viewerIdentifier String // This could be an IP address or a session ID
  createdAt        DateTime @default(now())

  @@unique([blogId, viewerIdentifier]) // Ensures a unique view per blog per viewer
}

// ============ PRODUCT STORAGE ============
// Products synced from Stripe for fast database reads

model Product {
  id          String   @id // Stripe product ID (prod_xxx)
  name        String
  description String?  @db.Text
  images      String[] // Array of image URLs
  active      Boolean  @default(true)

  // All Stripe metadata stored as JSON
  metadata Json?

  // Relations
  prices Price[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("products")
}

model Price {
  id        String  @id // Stripe price ID (price_xxx)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitAmount Int // Amount in cents
  currency   String  @default("usd")
  active     Boolean @default(true)
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([active])
  @@map("prices")
}

model ProductNutrition {
  id        String @id @default(uuid())
  productId String @unique
  // Note: No FK constraint - productId references Stripe product ID
  // which may or may not exist in our products table
  nutrition String
}

model Review {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  rating      Float
  comment     String?
  otherRating Json?
  createdAt   DateTime
  updatedAt   DateTime
}

model Order {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  total           Float
  lineItems       Json
  shippingAddress String?
  metadata        Json?
  status          String
  createdAt       DateTime
  updatedAt       DateTime

  @@map("order")
}

model Wishlist {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String[]
  createdAt DateTime
  updatedAt DateTime
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]

  stripeCustomerId String? @unique

  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?
  Blog       Blog[]
  affiliate  Affiliate?
  referredBy Referral?  @relation("ReferredUser")
  Referral   Referral?  @relation(fields: [referralId], references: [id])
  referralId String?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// affilation

model Affiliate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Affiliate details
  referralCode   String          @unique
  status         AffiliateStatus @default(PENDING)
  commissionRate Float           @default(10.0) // percentage or fixed amount
  commissionType CommissionType  @default(PERCENTAGE)

  // Payment info
  paypalEmail   String?
  bankAccount   String?
  paymentMethod PaymentMethod?

  // Statistics
  totalClicks      Int   @default(0)
  totalConversions Int   @default(0)
  totalEarnings    Float @default(0)
  availableBalance Float @default(0)
  lifetimeEarnings Float @default(0)

  // Metadata
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  // Relations
  referrals   Referral[]
  commissions Commission[]
  payouts     Payout[]
  clicks      AffiliateClick[]

  @@index([referralCode])
  @@index([status])
  @@map("affiliates")
}

// Track referral clicks
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  // Click details
  ipAddress   String?
  userAgent   String?
  referer     String?
  landingPage String?

  // Tracking
  converted   Boolean   @default(false)
  convertedAt DateTime?

  createdAt DateTime @default(now())

  @@index([affiliateId])
  @@index([ipAddress, createdAt])
  @@index([converted])
  @@map("affiliate_clicks")
}

// Purchase referral record (main conversion)
model Referral {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  // Customer info
  userId String? @unique
  user   User?   @relation("ReferredUser", fields: [userId], references: [id], onDelete: SetNull)
  email  String?

  // Purchase details
  status      ReferralStatus @default(PENDING)
  orderValue  Float          @default(0) // Total purchase amount
  productId   String // Product identifier
  productName String // Product name
  quantity    Int            @default(1) // Quantity of products purchased

  // Tracking
  ipAddress   String?
  convertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  commissions Commission[]
  User        User[]

  @@index([affiliateId])
  @@index([email])
  @@index([status])
  @@index([convertedAt])
  @@map("referrals")
}

// Commission records (payment to affiliate)
model Commission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  // Commission details
  amount Float
  type   CommissionType
  rate   Float // Rate at time of commission
  status CommissionStatus @default(PENDING)

  // Payout tracking
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  // Metadata
  description String?
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  @@index([affiliateId])
  @@index([referralId])
  @@index([status])
  @@index([createdAt])
  @@map("commissions")
}

// Payout records (batch payments to affiliates)
model Payout {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  // Payout details
  amount Float
  method PaymentMethod
  status PayoutStatus  @default(PENDING)

  // Payment details
  transactionId  String?
  paymentEmail   String?
  paymentAccount String?

  // Metadata
  notes         String?
  failureReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?
  completedAt DateTime?

  // Relations
  commissions Commission[]

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@map("payouts")
}

// Support Requests
model SupportRequest {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String               @db.Text
  status    SupportRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("support_requests")
}

// Newsletter Subscriptions
model NewsletterSubscription {
  id        String                       @id @default(cuid())
  email     String                       @unique
  source    String? // Where the subscription came from (e.g., "hero", "footer", "popup")
  status    NewsletterSubscriptionStatus @default(ACTIVE)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("newsletter_subscriptions")
}

enum NewsletterSubscriptionStatus {
  ACTIVE // Subscribed and receiving emails
  UNSUBSCRIBED // User unsubscribed
  BOUNCED // Email bounced
}

enum SupportRequestStatus {
  PENDING // New request, not yet reviewed
  IN_REVIEW // Currently being reviewed
  RESOLVED // Issue resolved
  CLOSED // Request closed
}

// Enums
enum AffiliateStatus {
  PENDING // Waiting for admin approval
  ACTIVE // Can earn commissions
  SUSPENDED // Temporarily disabled
  REJECTED // Application rejected
}

enum ReferralStatus {
  PENDING // Purchase initiated but not completed
  COMPLETED // Purchase completed successfully
  CANCELLED // Purchase cancelled
  REFUNDED // Purchase refunded
}

enum CommissionType {
  PERCENTAGE // Commission based on percentage of sale
  FIXED // Fixed amount per sale
}

enum CommissionStatus {
  PENDING // Awaiting approval
  APPROVED // Approved, ready for payout
  PAID // Already paid out
  CANCELLED // Cancelled (e.g., due to refund)
}

enum PaymentMethod {
  PAYPAL
  BANK_TRANSFER
  STRIPE
  CRYPTO
}

enum PayoutStatus {
  PENDING // Waiting to be processed
  PROCESSING // Currently being processed
  COMPLETED // Successfully completed
  FAILED // Payment failed
  CANCELLED // Payout cancelled
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}
