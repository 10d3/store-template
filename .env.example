# ============================================================================
# Environment variables for store-template
# Copy to `.env` and fill in real values.  (vars prefixed NEXT_PUBLIC_ are
# exposed to the browser — never put secrets in those.)
# ============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — REQUIRED
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ---------------------------------------------------------------------------
# App URLs — REQUIRED
# Used for checkout success/cancel redirects, auth callbacks, OG images, etc.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Root domain used to build Stripe Connect (affiliate) redirect URLs.
NEXT_PUBLIC_ROOT_DOMAIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Authentication — better-auth — REQUIRED
# BETTER_AUTH_SECRET: random 32+ char string (generate: `openssl rand -base64 32`)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (social login) — required only if you enable Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Stripe (payments) — REQUIRED
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint you point at /api/auth/* (better-auth/stripe)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Browser-side publishable key (only needed for embedded/Elements flows)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe Connect client id — used by the affiliate payout / connect flow
NEXT_PUBLIC_STRIPE_CLIENT_ID="ca_..."

# ---------------------------------------------------------------------------
# Email — Resend — REQUIRED (order/tracking/payout/contact emails)
# https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_..."
# Address that receives new-order owner notifications
STORE_OWNER_EMAIL="owner@example.com"

# ---------------------------------------------------------------------------
# File uploads — UploadThing (v7) — REQUIRED for image uploads in admin
# Single token from https://uploadthing.com/dashboard → API Keys
# ---------------------------------------------------------------------------
UPLOADTHING_TOKEN=""

# ---------------------------------------------------------------------------
# Background jobs — Inngest
# Local dev (inngest-cli dev) works without these. REQUIRED in production
# for the CJ fulfillment / tracking / inventory jobs and payouts.
# ---------------------------------------------------------------------------
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# ---------------------------------------------------------------------------
# CJ Dropshipping — REQUIRED to use CJ import / fulfillment / tracking / stock
# CJ_API_KEY: dashboard → Account → API (format: CJUserNum@api@<key>)
# ---------------------------------------------------------------------------
CJ_API_KEY="CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional — defaults shown
CJ_API_BASE="https://developers.cjdropshipping.com/api2.0/v1"
# Origin country for CJ shipping/freight (2-letter code), default CN
CJ_FROM_COUNTRY_CODE="CN"

# ---------------------------------------------------------------------------
# Misc (optional)
# ---------------------------------------------------------------------------
# NODE_ENV=development
