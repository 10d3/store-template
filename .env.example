# Copy to `.env` and fill in real values.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser — never put secrets there.

# Database (PostgreSQL) — required
DATABASE_URL="postgresql://user:password@localhost:5432/vitanou?schema=public"

# App URLs — required
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication — required
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — optional
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe — required
# Webhook endpoint: /api/webhooks/stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"

# Shipping — optional. 0 means free shipping.
FLAT_SHIPPING_CENTS="0"
FLAT_SHIPPING_LABEL="Standard shipping"

# Email — Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="Vitanou <noreply@vitanou.com>"

# Admin image uploads — UploadThing
UPLOADTHING_TOKEN=""
